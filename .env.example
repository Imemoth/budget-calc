# Supabase project URL (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Vesszővel elválasztott admin email-ek (opcionális, reset/admin funkciókhoz)
VITE_ADMIN_EMAILS=admin@example.com,other@example.com
